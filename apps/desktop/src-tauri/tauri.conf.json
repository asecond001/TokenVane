{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenVane",
  "version": "0.4.11",
  "identifier": "com.tokenvane.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenVane",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQTRDMDZFNDgxNjA0MzcKUldRM0JCWklic0NrdjR3NUNkcUM5ajVWdlFYVVphQkFna3NUS0RWTFpvZ0RlMlhPeGFZRUtDWFEK",
      "endpoints": [
        "https://github.com/asecond001/TokenVane/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
